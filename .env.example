# STUN servers used while gathering ICE candidates. STUN only tells a device
# its own public address — no data and no signalling passes through it — but it
# is still a lookup at a third party that sees the device's IP.
#
# Point this at your own STUN server to avoid that, or append `?ice=host` to
# the URL to gather host candidates only (LAN and CI; no NAT traversal).
VITE_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun.cloudflare.com:3478
